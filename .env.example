# Copy to .env.local and fill in. .env.local is gitignored.

# 21st.dev credential — tooling only, not read by the site at runtime.
# Used by the `21st` CLI (npx @21st-dev/cli) and the 21st MCP server to search,
# install and generate components. Get one at https://21st.dev/settings/api-keys
#
# The CLI also accepts TWENTYFIRST_TOKEN or --api-key <key>; API_KEY_21ST is the
# name the MCP config template expects.
#
# Never expose as NEXT_PUBLIC_* — it is a secret key.
API_KEY_21ST=21st_sk_...
